# Local-first defaults. Replace these for deployed PostgreSQL/Redis integrations.
DETOUR_DATABASE_URL=sqlite:///./data/detour.db
DETOUR_SECRET_KEY=replace-with-a-long-random-secret
DETOUR_AUTH_DISABLED=true
DETOUR_ACCESS_TOKEN_MINUTES=30
DETOUR_REFRESH_TOKEN_DAYS=30
DETOUR_COOKIE_SECURE=false
DETOUR_NOMINATIM_URL=https://nominatim.openstreetmap.org
DETOUR_OVERPASS_URL=https://overpass-api.de/api/interpreter
DETOUR_OSM_USER_AGENT=Detour/0.1 (+https://your-domain.example; contact: maps@your-domain.example)
DETOUR_GOOGLE_ROUTES_KEY=
DETOUR_OPENROUTER_API_KEY=
DETOUR_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DETOUR_OPENROUTER_QUEST_MODEL=openai/gpt-4o-mini
DETOUR_OPENROUTER_TIMEOUT_SECONDS=45
DETOUR_OPENROUTER_SITE_URL=https://github.com/detour
DETOUR_OPENROUTER_APP_NAME=Detour
DETOUR_REDIS_URL=
