# Local-first SQLite storage.
DETOUR_DATABASE_URL=sqlite:///./data/detour.db
DETOUR_NOMINATIM_URL=https://nominatim.openstreetmap.org
DETOUR_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Comma-separated mirrors tried after the primary URL fails (406/timeout/5xx are common).
DETOUR_OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# Use a real contact URL/email — some OSM mirrors reject placeholder User-Agents.
DETOUR_OSM_USER_AGENT="Detour/0.1 (local-dev; contact: maps@localhost)"
DETOUR_GOOGLE_ROUTES_KEY=
DETOUR_GOOGLE_ROUTES_URL=https://routes.googleapis.com
DETOUR_GOOGLE_ROUTES_TIMEOUT_SECONDS=15
DETOUR_GOOGLE_PLACES_KEY=
DETOUR_OPENROUTER_API_KEY=
DETOUR_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DETOUR_OPENROUTER_QUEST_MODEL=openai/gpt-4o-mini
DETOUR_OPENROUTER_TIMEOUT_SECONDS=45
DETOUR_OPENROUTER_SITE_URL=https://github.com/detour
DETOUR_OPENROUTER_APP_NAME=Detour
