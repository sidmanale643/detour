# Core local services
APP_ENV=development
DATABASE_URL=postgresql://detour:detour@localhost:5432/detour
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Maps and routing
# Replace these public community services with hosted or self-hosted endpoints for production traffic.
# Vector TileJSON source for the illustrated gameplay map. The area picker keeps using the raster URL below.
NEXT_PUBLIC_GAME_MAP_TILEJSON_URL=https://tiles.openfreemap.org/planet
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
DETOUR_NOMINATIM_URL=https://nominatim.openstreetmap.org
DETOUR_OVERPASS_URL=https://overpass-api.de/api/interpreter
DETOUR_OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter
DETOUR_OSM_USER_AGENT="Detour/0.1 (+https://your-domain.example; contact: maps@your-domain.example)"
# Optional: transit summaries are unavailable when omitted.
GOOGLE_MAPS_API_KEY=

# Quest generation. This key must never be exposed to the browser.
OPENROUTER_API_KEY=
OPENROUTER_QUEST_MODEL=
